-- Tabel Note sesuai materi slide 7
CREATE TABLE Note (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    title      TEXT    NOT NULL,
    content    TEXT    NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Select all notes
selectAll:
SELECT * FROM Note ORDER BY updated_at DESC;

-- Select favorites
selectFavorites:
SELECT * FROM Note WHERE isFavorite = 1 ORDER BY updated_at DESC;

-- Search notes
search:
SELECT * FROM Note
WHERE title LIKE '%' || :query || '%'
   OR content LIKE '%' || :query || '%'
ORDER BY updated_at DESC;

-- Select by id
selectById:
SELECT * FROM Note WHERE id = ?;

-- Insert
insert:
INSERT INTO Note(title, content, isFavorite, created_at, updated_at)
VALUES (?, ?, 0, ?, ?);

-- Update
update:
UPDATE Note SET title = ?, content = ?, updated_at = ? WHERE id = ?;

-- Delete
delete:
DELETE FROM Note WHERE id = ?;

-- Toggle favorite
toggleFavorite:
UPDATE Note
SET isFavorite = CASE WHEN isFavorite = 1 THEN 0 ELSE 1 END
WHERE id = ?;
